{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/nf-core/contaminationqc/master/assets/schema_input.json",
    "title": "nf-core/contaminationqc pipeline - params.input schema",
    "description": "Schema for the file provided with params.input",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "sample": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]+$",
                "errorMessage": "Sample name must be provided and may only contain letters, digits, '.', '_' and '-'",
                "meta": ["id"]
            },
            "bam": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^\\S+\\.(bam|cram)$",
                "errorMessage": "BAM/CRAM file must be provided, cannot contain spaces and must have extension '.bam' or '.cram'"
            },
            "bai": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^\\S+\\.(bai|csi|crai)$",
                "errorMessage": "Index file must be provided, cannot contain spaces and must have extension '.bai', '.csi' or '.crai'"
            },
            "individual": {
                "type": "string",
                "pattern": "^\\S*$",
                "errorMessage": "Individual (patient) ID cannot contain spaces",
                "meta": ["individual"],
                "default": ""
            },
            "batch": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]*$",
                "errorMessage": "Batch ID may only contain letters, digits, '.', '_' and '-'",
                "meta": ["batch"],
                "default": ""
            }
        },
        "required": ["sample", "bam", "bai"]
    },
    "uniqueEntries": ["sample"]
}
