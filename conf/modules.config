/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    //
    // References
    //
    withName: 'SAMTOOLS_FAIDX|UNTAR_KRAKEN2_DB|UNTAR_BRACKEN_DB' {
        publishDir = [ enabled: false ]
    }

    withName: 'SOMALIERCONTAM_RESTRICTSITES' {
        ext.args   = { "--pad ${params.bed_pad}" }
        publishDir = [
            path: { "${params.outdir}/references" },
            mode: params.publish_dir_mode,
        ]
    }

    //
    // somalier
    //
    withName: 'SOMALIER_EXTRACT' {
        // pipeline sample ID becomes the prefix of the name stored in the digest -> unique names
        ext.args   = { "--sample-prefix ${meta.id}__" }
        publishDir = [
            path: { "${params.outdir}/somalier/extract" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'SOMALIER_RELATE' {
        ext.args   = { "-d ${params.min_depth}" }
        ext.prefix = { "${meta.id}.relate" }
        publishDir = [
            path: { "${params.outdir}/somalier/relate" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'SOMALIER_CONTAMINATION' {
        ext.args   = { "--min-depth ${params.min_depth}" }
        ext.prefix = { "${meta.id}.contamination" }
        publishDir = [
            path: { "${params.outdir}/somalier/contamination" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'SOMALIERCONTAM_IDENTITY' {
        ext.args   = { [
            "--min-depth ${params.min_depth}",
            "--hom-max-af ${params.hom_max_af}",
            "--het-min-af ${params.het_min_af}",
            "--identity-max-disc ${params.identity_max_disc}",
            "--min-identity-sites ${params.min_identity_sites}",
        ].join(' ') }
        publishDir = [
            path: { "${params.outdir}/contamination/identity" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'SOMALIERCONTAM_ATTRIBUTE' {
        ext.args   = { [
            "--min-depth ${params.min_depth}",
            "--hom-max-af ${params.hom_max_af}",
            "--het-min-af ${params.het_min_af}",
            "--error-rate ${params.error_rate}",
            "--max-eff-depth ${params.max_eff_depth}",
            "--shard ${meta.shard_index}/${meta.n_shards}",
        ].join(' ') }
        publishDir = [ enabled: false ]
    }

    withName: 'SOMALIERCONTAM_REPORT' {
        ext.args   = { [
            "--contam-threshold ${params.contam_threshold}",
            "--min-llr ${params.min_llr}",
            "--min-margin ${params.min_margin}",
            "--relatedness-threshold ${params.relatedness_flag_threshold}",
            "--top-candidates ${params.report_top_candidates}",
            "--max-heatmap-samples ${params.max_heatmap_samples}",
        ].join(' ') }
        publishDir = [
            path: { "${params.outdir}/contamination" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.endsWith('_mqc.tsv') ? null : filename },
        ]
    }

    //
    // Kraken2 / Bracken
    //
    withName: 'SAMTOOLS_FASTQ' {
        ext.args   = { params.kraken2_reads == 'unmapped' ? '-f 12' : '-F 0x900' }
        ext.prefix = { "${meta.id}.${params.kraken2_reads}" }
        publishDir = [ enabled: false ]
    }

    withName: 'KRAKEN2_KRAKEN2' {
        ext.args   = { params.kraken2_memory_mapping ? '--memory-mapping' : '' }
        publishDir = [
            path: { "${params.outdir}/kraken2" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'BRACKEN_BRACKEN' {
        ext.args   = { "-l ${params.bracken_level} -r ${params.bracken_read_length}" }
        publishDir = [
            path: { "${params.outdir}/bracken" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode
        ]
    }

}
