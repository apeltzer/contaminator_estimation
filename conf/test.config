/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.
    Synthetic data with a known truth (see tests/data/simulate_test_data.py):
      P3_A is 5 % contaminated by P2_A (source in cohort), P4_A is 4 % contaminated by an
      individual not in the cohort and carries sarscov2 read pairs.

    Use as follows:
        nextflow run nf-core/contaminationqc -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal synthetic test dataset to check pipeline function'

    input        = "${projectDir}/tests/data/samplesheet.csv"
    fasta        = "${projectDir}/tests/data/genome.fasta"
    sites        = "${projectDir}/tests/data/sites.vcf.gz"
    panel_bed    = "${projectDir}/tests/data/panel.bed"

    run_kraken2  = true
    kraken2_db   = params.pipelines_testdata_base_path + 'modules/data/genomics/sarscov2/genome/db/kraken2.tar.gz'
}
